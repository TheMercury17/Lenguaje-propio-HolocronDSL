-- Ejemplo 01: Telemetria y filtrado basico de la flota estelar
-- Sintaxis simplificada e intuitiva

-- Cargar registros historicos de telemetria
flota_completa = abrir_holocron "examples/datos/telemetria_flota.csv"

-- Limpiar registros: seleccionar atributos, purgar naves sin escudos y ordenar
flota_operativa = flota_completa
    |> revelar [ identificador, modelo, faccion, escudos, victorias ]
    |> purgar donde escudos > 50 y victorias >= 5
    |> forjar indice_efectividad = victorias * 10 + escudos / 2
    |> ordenar por indice_efectividad descendente

-- Guardar los resultados en el archivo de salida
archivar_holocron flota_operativa en "salidas/flota_operativa.csv"

-- Notificar a la tripulacion
mostrar "Telemetria procesada exitosamente en los sistemas de navegacion."
