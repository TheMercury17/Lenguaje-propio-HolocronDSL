-- Ejemplo 03: Proyecciones holograficas de telemetria galactica
-- Demuestra el reconocimiento sintactico de los distintos tipos de graficas

datos_flota = abrir_holocron "examples/datos/telemetria_flota.csv"

-- Proyeccion holografica de barras para comparar victorias por faccion
holograma barras datos_flota
    eje_x "faccion"
    eje_y "victorias"
    titulo "Total de victorias registradas por faccion"
    guardar "salidas/victorias_por_faccion.png"

-- Proyeccion holografica de dispersion para correlacionar escudos con victorias
holograma dispersion datos_flota
    eje_x "escudos"
    eje_y "victorias"
    titulo "Distribucion de capacidad defensiva vs victorias"
    guardar "salidas/escudos_vs_victorias.png"

-- Proyeccion holografica de histograma para analizar niveles de escudo
holograma histograma datos_flota
    eje_x "escudos"
    titulo "Frecuencia de rangos de escudos"
    guardar "salidas/distribucion_escudos.png"
